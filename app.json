{
  "expo": {
    "name": "Nail Pay Track",
    "slug": "nail-pay-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f3"
    },
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "72688229-84e1-4aa1-9c47-9859aa8d1261"
      }
    },
    "owner": "nail-pay-track-org",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/72688229-84e1-4aa1-9c47-9859aa8d1261"
    },
    "android": {}
  }
}
