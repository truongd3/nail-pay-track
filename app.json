{
  "expo": {
    "name": "Nail Pay Track",
    "slug": "nail-pay-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f3"
    },
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3",
          "imageWidth": 200
        }
      ]
    ]
  }
}
